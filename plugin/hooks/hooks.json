{
  "description": "Quiet startup; guards apply only to a matching delegated session, prompt and repository.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y cheap-agent@1.3.2 hook guard; exit 0",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*cheapag__(delegate|jobs|reply|land)",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y cheap-agent@1.3.2 hook result; exit 0",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y cheap-agent@1.3.2 hook context",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
